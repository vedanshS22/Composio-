<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Scout100 | App integration research</title><style>
:root{--ink:#182337;--muted:#627086;--bg:#f4f7fb;--card:#fff;--accent:#6750e8}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 Inter,system-ui,sans-serif}.wrap{max-width:1560px;margin:auto;padding:34px 24px}header{padding:36px 0 20px}h1{font-size:clamp(34px,5vw,60px);letter-spacing:-.06em;margin:0 0 10px}h2{margin:0 0 14px;font-size:25px;letter-spacing:-.03em}p,.small{color:var(--muted)}.tag{color:var(--accent);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{background:var(--card);border:1px solid #e5e9f1;border-radius:14px;padding:18px}.number{font-size:29px;font-weight:800}.label{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}section{margin:40px 0}.notice{background:#fff8e8;border:1px solid #f6d696;padding:14px;border-radius:10px;color:#70450b}table{width:100%;border-collapse:collapse;background:#fff;font-size:13px}th,td{text-align:left;padding:10px;border-bottom:1px solid #e8ebf1;vertical-align:top}th{position:sticky;top:0;background:#edf1f8;font-size:11px;text-transform:uppercase}.scroll{overflow:auto;border:1px solid #e5e9f1;border-radius:12px;max-height:650px}a{color:#4b35ca}.workflow{display:flex;gap:8px;flex-wrap:wrap}.step{background:#fff;border:1px solid #e5e9f1;border-radius:8px;padding:10px;font-weight:600}.miss{background:#fff4ef}@media(max-width:760px){.grid{grid-template-columns:1fr}.wrap{padding:20px 12px}table{font-size:12px}}
</style></head><body><main class="wrap">
<header><div class="tag">Evidence-first research agent · static case study</div><h1>{{ report_scope }} app integration{% if report_scope != 1 %}s{% endif %}, researched as an agent workflow.</h1><p>Each row is generated from fetched documentation, retained with field-level provenance, and explicitly marked unknown only for the unresolved field.</p></header>
<section aria-labelledby="patterns"><h2 id="patterns">What the dataset says</h2><div class="grid"><div class="card"><div class="number">{{ patterns.total_apps }}</div><div class="label">Apps with a current finding</div></div><div class="card"><div class="number">{{ patterns.buildability_split.get('yes',0) + patterns.buildability_split.get('yes_with_caveats',0) }}</div><div class="label">Potential toolkit candidates</div></div><div class="card"><div class="number">{{ verification.pass1_accuracy if verification.pass1_accuracy is not none else '—' }}{% if verification.pass1_accuracy is not none %}%{% endif %} → {{ verification.pass2_accuracy if verification.pass2_accuracy is not none else '—' }}{% if verification.pass2_accuracy is not none %}%{% endif %}</div><div class="label">Field match rate: pass 1 → pass 2</div></div></div></section>
{% if verification.accuracy is none %}<div class="notice"><strong>Verification is pending.</strong> Run <code>python scripts/run_verification.py</code> after the first research pass. The report intentionally does not claim an accuracy number without field-level checks.</div>{% endif %}
<section><h2>Findings</h2><p class="small">Evidence labels link to the exact source supporting the respective field. Research-pipeline failures are retained in metadata and never presented as product blockers.</p><div class="scroll"><table><thead><tr><th>App</th><th>Category</th><th>What it does</th><th>Auth</th><th>Access</th><th>API Surface</th><th>MCP</th><th>Buildability</th><th>Main Blocker / Caveat</th><th>Evidence / Sources</th></tr></thead><tbody>{% for app in apps %}<tr><td><strong>{{ app.app }}</strong><br><span class="small">{{ app.research_status }}</span></td><td>{{ app.category }}</td><td>{{ app.what_it_does }}</td><td>{{ app.auth }}</td><td>{{ app.access }}</td><td>{{ app.api_surface|replace('\n','<br>')|safe }}</td><td>{{ app.mcp }}</td><td>{{ app.buildability }}</td><td>{{ app.main_blocker_or_caveat }}</td><td>{% for evidence in app.evidence %}<a href="{{ evidence.url }}" rel="noopener">{{ evidence.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% if not app.evidence %}No field-level source yet{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
<section><h2>How it was built</h2><div class="workflow"><div class="step">Fixed 100-app seed</div><div class="step">Fetch official docs</div><div class="step">Schema-constrained LLM extraction</div><div class="step">Append-only SQLite passes</div><div class="step">Stratified independent verification</div><div class="step">Static report + JSON</div></div></section>
<section><h2>Verification: hits and misses</h2><p>{{ verification.matched }}/{{ verification.fields_checked }} compared fields matched. Verification is an independent re-fetch from a blank extraction context; human spot-check notes remain a required final submission artifact.</p>{% if verification.mismatches %}<div class="scroll"><table><thead><tr><th>App</th><th>Field</th><th>Pass 1</th><th>Independent re-check</th><th>Notes</th></tr></thead><tbody>{% for item in verification.mismatches %}<tr class="miss"><td>{{ item.app }}</td><td>{{ item.field }}</td><td>{{ item.pipeline_value }}</td><td>{{ item.verified_value }}</td><td>{{ item.notes or '' }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="notice">No mismatch list exists yet. This is not evidence of perfect accuracy; run verification first.</div>{% endif %}</section>
</main><script type="application/json" id="scout100-data">{{ data_json }}</script></body></html>
