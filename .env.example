# Required to use the live extraction agent. Never commit the filled .env file.
LLM_PROVIDER=openrouter
LLM_MODEL=z-ai/glm-5.2
OPENROUTER_API_KEY=

# Alternative OpenAI-compatible provider.
# LLM_PROVIDER=aicredits
# LLM_BASE_URL=https://api.aicredits.in/v1
# AICREDITS_API_KEY=

# Optional Groq configuration for legacy health checks.
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# Optional: label runs that route discovery through your configured Composio MCP setup.
COMPOSIO_API_KEY=
